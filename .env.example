# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# GitHub OAuth App (http://localhost:3000/api/auth/callback/github)
# Create at https://github.com/settings/developers
# Requested scopes are read-only: read:user user:email
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# PostgreSQL (local Docker or Neon / Stripe Projects)
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker
